<div class="container mt-5 d-flex justify-content-center">
  <div class="card p-4 shadow" style="width: 500px;">

    <h1>Edit task</h1>

    <%= form_with model: @task do |f| %>
      <div class="mb-3">
        <%= f.label :title, class: "form-label" %>
        <%= f.text_field :title, class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= f.label :details, class: "form-label" %>
        <%= f.text_area :details, class: "form-control" %>
      </div>

      <div class="mb-3 form-check">
        <%= f.check_box :completed, class: "form-check-input" %>
        <%= f.label :completed, class: "form-check-label" %>
      </div>

      <%= f.submit "Update Task", class: "btn btn-primary" %>
    <% end %>

    <hr>

    <%= link_to tasks_path do %>
      <i class="fa-solid fa-rotate-left"></i> Back to list
    <% end %>

  </div>
</div>
