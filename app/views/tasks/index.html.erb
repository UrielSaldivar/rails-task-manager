<div class="container mt-5 d-flex justify-content-center">
  <div class="card p-4 shadow" style="width: 400px;">

    <h1 class="mb-4">My tasks</h1>

    <% @tasks.each do |task| %>
      <div class="d-flex align-items-center mb-2">

        <!-- Checkbox -->
        <input class="form-check-input me-2" type="checkbox" <%= "checked" if task.completed %>>
        
        <!-- Title -->
        <%= link_to task.title, task_path(task),
            class: "text-decoration-none flex-grow-1 #{'text-decoration-line-through text-muted' if task.completed}" %>

        <!-- Delete -->
        <%= link_to task_path(task),
            data: { turbo_method: :delete, turbo_confirm: "Are you sure?" },
            class: "text-danger ms-2" do %>
          <i class="fa-solid fa-trash"></i>
        <% end %>

      </div>
    <% end %>

    <!-- Button -->
    <div class="mt-4">
      <%= link_to new_task_path, class: "btn btn-primary w-100" do %>
        <i class="fa-solid fa-plus"></i> Add a new task
      <% end %>
    </div>

  </div>
</div>
