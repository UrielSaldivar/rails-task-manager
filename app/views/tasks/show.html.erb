<div class="container mt-5 d-flex justify-content-center">
  <div class="card p-4 shadow" style="width: 500px;">

    <div class="d-flex justify-content-between align-items-center mb-3">
      <h1><%= @task.title %></h1>

      <%= link_to edit_task_path(@task), class: "btn btn-outline-secondary" do %>
        <i class="fa-solid fa-pen"></i> Edit
      <% end %>
    </div>

    <div class="card p-3 mb-3">
      <%= @task.details %>
    </div>

    <p>
      <% if @task.completed %>
        <i class="fa-regular fa-square-check"></i>
        This task is completed
      <% else %>
        <i class="fa-regular fa-square"></i>
        This task is not completed yet
      <% end %>
    </p>

    <hr>

    <%= link_to tasks_path do %>
      <i class="fa-solid fa-rotate-left"></i> Back to list
    <% end %>

  </div>
</div>
